# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=banana_brothers_db

# SMTP Email Configuration for Real OTP Delivery
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-character App Password (https://myaccount.google.com/apppasswords)
# 3. Use your full email address as SMTP_USER and the 16-character App Password as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Banana Brothers Events

# Security JWT Secret Key
SECRET_KEY=your_secure_random_secret_jwt_key_here
