# Environment variables (Secrets)
.env
.env.*
.env.local
*.env
server/.env
client/.env

# Whitelist public template and deployment configuration files
!.env.example
!client/.env.example
!client/.env.development
!client/.env.production
!server/.env.example

# Python bytecode and virtual environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Databases
*.sqlite
*.sqlite3
server/events.db
events.db

# User-uploaded files (directory preserved via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep

# Node / Frontend dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Preserve required frontend build and deployment assets
!client/dist/
!client/dist/**

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
